{
  "name": "@talyn/client",
  "version": "0.1.0",
  "description": "Talyn backend client — REST + WebSocket transport shared by every front end",
  "private": true,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./native": {
      "types": "./dist/cjs/native.d.ts",
      "import": "./dist/esm/native.js",
      "require": "./dist/cjs/native.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node ./scripts/write-type-markers.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && vitest run && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@talyn/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
