{
  "name": "talyn",
  "version": "0.1.0",
  "private": true,
  "description": "Mission control for AI-assisted software engineering",
  "workspaces": [
    "apps/desktop",
    "apps/web",
    "apps/admin",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:desktop\"",
    "dev:desktop": "npm run start -w @talyn/desktop",
    "dev:backend": "npm run dev -w @talyn/backend",
    "dev:db": "supabase start -x edge-runtime,functions,imgproxy,storage,realtime,vector,analytics,inbucket",
    "dev:db:stop": "supabase stop",
    "dev:redis": "docker compose up -d redis",
    "dev:redis:stop": "docker compose down",
    "build": "npm run build -w @talyn/shared && npm run build -w @talyn/client && npm run build -w @talyn/backend && npm run build -w @talyn/desktop",
    "build:desktop": "npm run build -w @talyn/desktop",
    "build:backend": "npm run build -w @talyn/backend",
    "package": "npm run package -w @talyn/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run build -w @talyn/shared && npm run build -w @talyn/client && tsc --noEmit -p packages/backend/tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json && tsc --noEmit -p apps/desktop/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/admin/tsconfig.json && npm run mobile:typecheck",
    "prepare": "husky",
    "build:web": "npm run build -w @talyn/web",
    "dev:web": "npm run dev -w @talyn/web",
    "build:admin": "npm run build -w @talyn/admin",
    "dev:admin": "npm run dev -w @talyn/admin",
    "mobile:start": "npm run start -w @talyn/mobile",
    "mobile:android": "npm run android -w @talyn/mobile",
    "mobile:ios": "npm run ios -w @talyn/mobile",
    "mobile:lint": "npm run lint -w @talyn/mobile",
    "mobile:typecheck": "npm run typecheck -w @talyn/mobile",
    "mobile:test": "npm run test -w @talyn/mobile",
    "mobile:expo:check": "npm run expo:check -w @talyn/mobile",
    "mobile:doctor": "npm run doctor -w @talyn/mobile",
    "mobile:export:smoke": "npm run export:smoke -w @talyn/mobile",
    "mobile:build:packages": "npm run build -w @talyn/shared && npm run build -w @talyn/client",
    "mobile:check:graph": "npm run check:graph -w @talyn/mobile",
    "mobile:release:check": "npm run release:check -w @talyn/mobile",
    "mobile:release:plan": "npm run release:plan -w @talyn/mobile --",
    "mobile:native:generate": "npm run native:generate -w @talyn/mobile",
    "mobile:native:inspect": "npm run native:inspect -w @talyn/mobile",
    "mobile:test:release": "npm run test:release -w @talyn/mobile",
    "mobile:native:check": "npm run native:check -w @talyn/mobile"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{js,jsx,ts,tsx}": [
      "eslint"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "react-test-renderer": "19.3.0",
    "supabase": "^2.105.0",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "express@4": {
      "qs": "^6.16.0"
    },
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0"
  },
  "engines": {
    "node": ">=18.x"
  }
}
