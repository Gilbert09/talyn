{
  "cli": {
    "version": "27.5.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "autoIncrement": false,
      "env": {
        "APP_ENV": "development",
        "MOBILE_UPDATES_ENABLED": "0"
      },
      "developmentClient": true
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "autoIncrement": false,
      "env": {
        "APP_ENV": "preview",
        "MOBILE_UPDATES_ENABLED": "1"
      }
    },
    "internal-beta": {
      "distribution": "store",
      "environment": "production",
      "channel": "internal-beta",
      "autoIncrement": false,
      "env": {
        "APP_ENV": "production",
        "MOBILE_UPDATES_ENABLED": "1"
      },
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "autoIncrement": false,
      "env": {
        "APP_ENV": "production",
        "MOBILE_UPDATES_ENABLED": "1"
      },
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "internal-beta": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      },
      "ios": {
        "ascAppId": "6834161436",
        "appleTeamId": "5KQY9SJDWG"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft",
        "changesNotSentForReview": true
      },
      "ios": {
        "ascAppId": "6834161436",
        "appleTeamId": "5KQY9SJDWG"
      }
    }
  }
}
