{
  "name": "@talyn/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Talyn native development shell",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --ext .js,.cjs,.ts,.tsx",
    "typecheck": "npm run routes:generate && tsc --noEmit",
    "routes:generate": "expo customize tsconfig.json",
    "postinstall": "patch-package",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "expo:check": "expo install --check",
    "doctor": "expo-doctor",
    "export:smoke": "expo export --platform all --output-dir dist/smoke --max-workers 2",
    "check:graph": "node scripts/check-dependency-graph.cjs",
    "release:check": "node scripts/check-release.cjs",
    "release:plan": "node scripts/release.cjs",
    "native:generate": "expo prebuild --no-install --clean --platform all",
    "native:inspect": "node scripts/inspect-native.cjs",
    "eas-build-post-install": "patch-package && node scripts/posthog-symbols.cjs eas-install && cd ../.. && npm run mobile:build:packages",
    "test:release": "jest --runInBand --runTestsByPath src/__tests__/release.test.ts src/__tests__/releaseFlows.test.tsx",
    "native:check": "node scripts/check-native-profiles.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@posthog/react-native-plugin": "2.12.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.103.3",
    "@talyn/client": "*",
    "@talyn/shared": "*",
    "expo": "~58.0.24",
    "expo-application": "~58.1.2",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.19",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "fast-text-encoding": "1.0.6",
    "marked": "^16.4.2",
    "posthog-react-native": "4.84.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-drawer-layout": "^4.2.12",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.18.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.14",
    "patch-package": "8.0.1",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  }
}
