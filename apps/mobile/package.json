{
  "name": "@talyn/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Talyn native development shell",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --ext .js,.cjs,.ts,.tsx",
    "typecheck": "npm run routes:generate && tsc --noEmit",
    "routes:generate": "expo customize tsconfig.json",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "expo:check": "expo install --check",
    "doctor": "expo-doctor",
    "export:smoke": "expo export --platform all --output-dir dist/smoke --max-workers 2",
    "check:graph": "node scripts/check-dependency-graph.cjs",
    "release:check": "node scripts/check-release.cjs",
    "release:plan": "node scripts/release.cjs",
    "native:generate": "expo prebuild --no-install --clean --platform all",
    "native:inspect": "node scripts/inspect-native.cjs",
    "eas-build-post-install": "cd ../.. && npm run mobile:build:packages",
    "test:release": "jest --runInBand --runTestsByPath src/__tests__/release.test.ts src/__tests__/releaseFlows.test.tsx",
    "native:check": "node scripts/check-native-profiles.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.103.3",
    "@talyn/client": "*",
    "@talyn/shared": "*",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "fast-text-encoding": "1.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.18.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.14",
    "test-renderer": "^1.0.0",
    "typescript": "~6.0.3"
  }
}
